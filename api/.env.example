# The API also reads ../.env (the Assignment 1 file used by the seeders),
# so usually you only need the root .env. Values here override it.
API_PORT=4000
# Comma-separated origins allowed to call the API (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
# Insert live TelemetryPings every few seconds so the map has fresh data
# (seeded pings expire after 2 hours because of the TTL index).
SIMULATE_TELEMETRY=true
SIMULATOR_TICK_MS=5000
SIMULATOR_VEHICLES_PER_TICK=150
# Optional: serve the built front end (web/dist) from the API
# WEB_DIST=../web/dist
